# Copy to .env.local and fill in real values. Never commit .env.local.

# Airtable
# Get token from ~/Desktop/claude-projects/.credentials/airvues/airvues_airtable_apiKey.txt
# Token is server-only; never bundled to the browser (lib/airtable.ts has "server-only" import marker).
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=app4vhhWMbRFOloOU

# NextAuth (Google)
# Create OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized origins: http://localhost:3000  (and https://ops.airvues.com in production)
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_SECRET=
# Generate AUTH_SECRET: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# App Users — JSON array. Email match → role.
# leetsao1@gmail.com is allowed because Lee's personal Gmail predates the airvues.com Workspace.
# All other admin/editor/viewer roles are @airvues.com (enforced server-side via hd=airvues.com OAuth param).
ALLOWED_USERS='[{"email":"leetsao1@gmail.com","role":"admin"},{"email":"enrique@airvues.com","role":"admin"},{"email":"shania@airvues.com","role":"editor"},{"email":"jose@airvues.com","role":"editor"},{"email":"bracho@airvues.com","role":"editor"},{"email":"cody@airvues.com","role":"viewer"}]'

# Application URL (used by NextAuth for callbacks)
NEXTAUTH_URL=http://localhost:3000

# ============================================================================
# SAML SSO via Google Workspace (optional — enable instead of OAuth allowlist)
# ============================================================================
# Set AUTH_METHOD=saml to enable. Leave unset (or set to anything else) for OAuth.
# Full setup guide: docs/auth-saml-setup.md
AUTH_METHOD=

# IdP (Google Workspace SAML app) — values from Google admin console SAML app setup.
# Lee's IdP (from GoogleIDPMetadata (2).xml exported 2026-05-16):
SAML_IDP_SSO_URL=https://accounts.google.com/o/saml2/idp?idpid=C00gli3uu
SAML_IDP_ENTITY_ID=https://accounts.google.com/o/saml2?idpid=C00gli3uu
# IdP signing certificate — paste the full PEM with literal \n between lines.
# Pulled from your downloaded GoogleIDPMetadata XML — refresh if Google rotates (their cert expires 2029-12-19).
SAML_IDP_CERT="-----BEGIN CERTIFICATE-----\nMIIDdDCCAlygAwIBAgIGAZPhpgLoMA0GCSqGSIb3DQEBCwUAMHsxFDASBgNVBAoTC0dvb2dsZSBJ\nbmMuMRYwFAYDVQQHEw1Nb3VudGFpbiBWaWV3MQ8wDQYDVQQDEwZHb29nbGUxGDAWBgNVBAsTD0dv\nb2dsZSBGb3IgV29yazELMAkGA1UEBhMCVVMxEzARBgNVBAgTCkNhbGlmb3JuaWEwHhcNMjQxMjIw\nMDExOTMzWhcNMjkxMjE5MDExOTMzWjB7MRQwEgYDVQQKEwtHb29nbGUgSW5jLjEWMBQGA1UEBxMN\nTW91bnRhaW4gVmlldzEPMA0GA1UEAxMGR29vZ2xlMRgwFgYDVQQLEw9Hb29nbGUgRm9yIFdvcmsx\nCzAJBgNVBAYTAlVTMRMwEQYDVQQIEwpDYWxpZm9ybmlhMIIBIjANBgkqhkiG9w0BAQEFAAOCAQ8A\nMIIBCgKCAQEAuYCKC1k+iXYBOM0zoD1Rs8B+znH0RSigH1bganYPa5DMExHXFYRT4tAmFZ6e+gjN\nZg2x4Cl539lIiTsVvgBSY3AXgBrmtD5cpp3FeDW9/FZ/ZcKmnuu8vpG2ILErZ5cEMEyJ+UP7WXW+\n9t5fu/BTKJVOw0E1xgaM0PTfZWa0KWJSOpFJnd1k9hr5KfSUZ0gr9MBW5pIWBwPEFIiJfgYN9NpP\n3JM1rYTwg2b7ahoY1okBeRu6OYFlIx84ZsYbQ3hbN8mFZTBtGZhYh3qY9EjxWmZ399ljATK0Ugte\nERuHfqb+XQOc0mSpGHwv+F15C3CeFDD8BxCZ7//THA/NOevh6QIDAQABMA0GCSqGSIb3DQEBCwUA\nA4IBAQBqulwjsjLm903FxmumCD24rWk8FY8YnuMw+qdffFZy+sw1QwzewhKDOnOljy6Pi6CKU7lv\nEctJ1z8XOQvE3QqnrWd29bEGVsAO9sv4OBgDrdnCk6R1Ahyj/3F/UiKCxmGwqDv0QblD4+J9UPzY\nXjsP0yBwexkkMgO3s+ot/N+E/GI0R9ZlHHhRHth2DPHEC08GO56Qz5w1PM9mynDS+ingZazf6Qi2\nbJXi2ux/H7klaf9sBD3VNhg3l/rAKoYC3NdGSyQQx7W4R1R4i67Q9vdzwtXyWcn9LvfVrOBqYJXd\nidShC5K+aMohoZA1qKddwDKMSlZ2as7ui41TLvcc9bTK\n-----END CERTIFICATE-----"

# SP (Airvues Ops) — must match what you configured in Google admin under "Service provider details"
SAML_SP_ENTITY_ID=airvues-ops-dev
SAML_SP_ACS_URL=http://localhost:3000/api/auth/saml/sso

# SP signing keypair — already generated as saml-sp-{key,cert}.pem (gitignored).
# Paste into .env.local with this one-liner from the repo root:
#   echo "SAML_SP_KEY=\"$(awk 'BEGIN{ORS="\\n"}1' saml-sp-key.pem)\"" >> .env.local
#   echo "SAML_SP_CERT=\"$(awk 'BEGIN{ORS="\\n"}1' saml-sp-cert.pem)\"" >> .env.local
SAML_SP_KEY=
SAML_SP_CERT=

# Group → role mapping. These must match the Google Group email addresses you created in Workspace admin.
SAML_GROUP_ADMIN=airvues-ops-admin@airvues.com
SAML_GROUP_EDITOR=airvues-ops-editor@airvues.com
SAML_GROUP_VIEWER=airvues-ops-viewer@airvues.com
